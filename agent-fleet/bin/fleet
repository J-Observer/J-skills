#!/bin/sh
set -eu
script=$0
while [ -L "$script" ]; do
  target=$(readlink "$script")
  case "$target" in
    /*) script=$target ;;
    *) script=$(dirname "$script")/$target ;;
  esac
done
dir=$(CDPATH= cd -P "$(dirname "$script")" && pwd -P)
if [ "${1:-}" = web ]; then
  shift
  exec node "$dir/chatgpt-web-ask.mjs" "$@"
fi
exec node "$dir/agent-fleet.mjs" "$@"
